{
  "services": {
    "teracar-luxury-fleet": {
      "root": "client"
    },
    "teracar-backend-api": {
      "root": "server",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "teracar-backend-api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "teracar-luxury-fleet" }
    }
  ]
}
