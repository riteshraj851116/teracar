# Vercel Project Environment Variables (Configure in Vercel Project Settings -> Environment Variables)

# 1. MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net

# 2. JWT Secret for Auth Token Signing
JWT_SECRET=your_jwt_super_secret_key_here

# 3. Node Environment
NODE_ENV=production

# 4. Optional: ImageKit Credentials
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# 5. Frontend Variables (Prefix with VITE_)
VITE_CURRENCY=₹
VITE_BASE_URL=
